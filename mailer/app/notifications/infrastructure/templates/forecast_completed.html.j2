<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Previsión ejecutada</title>
  <!--[if mso]>
  <style type="text/css">
    table { border-collapse: collapse; }
  </style>
  <![endif]-->
</head>
<body style="font-family: Arial, Helvetica, sans-serif; background-color: #f1f5f9; margin: 0; padding: 0;">
  <!-- Preheader (oculto, resumen en la bandeja de entrada) -->
  <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; mso-hide: all;">
    Previsión {{ forecast_system_name or ('#' ~ forecast_system_id) }} ejecutada el {{ executed_at | madrid_time }}.{% if zones %} {{ zones|length }} zona(s) analizada(s).{% endif %}
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f1f5f9; padding: 24px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" style="width: 640px; max-width: 640px; background-color: #ffffff; border-radius: 10px; overflow: hidden; border: 1px solid #e2e8f0;">

          <!-- Cºabecera de marca -->
          <tr>
            <td style="background-color: #0f172a; padding: 28px 32px; border-bottom: 3px solid #0ea5e9;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="font-size: 20px; font-weight: bold; color: #f8fafc; letter-spacing: 0.2px;">
                    Aquatica<span style="color: #0ea5e9;">Spo</span>
                  </td>
                  <td align="right" style="font-size: 12px; color: #94a3b8;">
                    Plataforma de previsión oceanográfica
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Estado -->
          <tr>
            <td style="padding: 28px 32px 4px 32px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="background-color: #ecfdf5; border-radius: 999px; padding: 4px 12px;">
                    <span style="color: #059669; font-size: 12px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.4px;">&#10003; Previsión ejecutada</span>
                  </td>
                </tr>
              </table>

              <h1 style="color: #0f172a; font-size: 19px; margin: 16px 0 6px 0;">
                {{ forecast_system_name or ('Sistema #' ~ forecast_system_id) }}
              </h1>
              <p style="color: #64748b; font-size: 14px; margin: 0 0 20px 0;">
                Ejecutado el <strong style="color: #334155;">{{ executed_at | madrid_time }}</strong> (hora de Madrid)
              </p>
            </td>
          </tr>

          {% set critical_zones = zones | selectattr('alert_level', 'in', ['orange', 'red']) | list %}
          {% if critical_zones %}
          <!-- Banner de atención -->
          <tr>
            <td style="padding: 0 32px 8px 32px;">
              {% set worst_color = '#dc2626' if (zones | selectattr('alert_level', 'equalto', 'red') | list) else '#f97316' %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #fff7ed; border: 1px solid #fed7aa; border-left: 4px solid {{ worst_color }}; border-radius: 6px;">
                <tr>
                  <td style="padding: 14px 16px;">
                    <p style="margin: 0; color: #7c2d12; font-size: 13.5px; line-height: 1.5;">
                      <strong>&#9888; Atención:</strong>
                      {{ critical_zones|length }} zona{{ 's' if critical_zones|length != 1 else '' }}
                      con remonte en nivel {{ 'rojo' if worst_color == '#dc2626' else 'naranja' }} o superior.
                      Revisa el detalle a continuación.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endif %}

          {% set overtopping_zones = zones | selectattr('max_q', 'gt', 10) | list %}
          {% if overtopping_zones %}
          <!-- Banner de rebase -->
          <tr>
            <td style="padding: 0 32px 8px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #fef2f2; border: 1px solid #fecaca; border-left: 4px solid #dc2626; border-radius: 6px;">
                <tr>
                  <td style="padding: 14px 16px;">
                    <p style="margin: 0; color: #7f1d1d; font-size: 13.5px; line-height: 1.5;">
                      <strong>&#9888; Rebase:</strong>
                      {{ overtopping_zones|length }} zona{{ 's' if overtopping_zones|length != 1 else '' }}
                      con caudal de rebase peligroso para peatones (&gt; 10 l/s/m).
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endif %}

          {% if wind_alert and wind_alert.level == 'red' %}
          <!-- Banner de viento -->
          <tr>
            <td style="padding: 0 32px 8px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #fef2f2; border: 1px solid #fecaca; border-left: 4px solid #dc2626; border-radius: 6px;">
                <tr>
                  <td style="padding: 14px 16px;">
                    <p style="margin: 0; color: #7f1d1d; font-size: 13.5px; line-height: 1.5;">
                      <strong>&#9888; Viento:</strong>
                      Se esperan vientos fuertes (&gt; 50 km/h).
                    </p>
                    {% set wind_ivs = wind_alert.get('intervals', []) %}
                    {% if wind_ivs %}
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 10px;">
                      {% for iv in wind_ivs %}
                      <tr>
                        <td style="padding: 3px 0; color: #7f1d1d; font-size: 12px;">
                          &#10148;
                          {{ iv.start_time | madrid_time if iv.start_time else '-' }}
                          &rarr;
                          {{ iv.end_time | madrid_time if iv.end_time else '-' }}
                          &nbsp;(&#8776; {{ '%.0f'|format(iv.max_wind_speed) }} km/h)
                        </td>
                      </tr>
                      {% endfor %}
                    </table>
                    {% endif %}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endif %}

          <!-- Detalle de zonas -->
          <tr>
            <td style="padding: 16px 32px 8px 32px;">
              <p style="color: #475569; font-size: 12px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 12px 0; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">
                Resumen por zona
              </p>
            </td>
          </tr>

          {% if zones %}
            {% for zone in zones %}
            {% set badge_text = '#ffffff' if zone.alert_level in ['red', 'orange'] else '#0f172a' %}
            <tr>
              <td style="padding: 0 32px 12px 32px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-left: 4px solid {{ zone.alert_color or '#94a3b8' }}; border-radius: 6px;">
                  <tr>
                    <td style="padding: 14px 16px 10px 16px;">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                          <td style="color: #0f172a; font-size: 14.5px; font-weight: bold;">
                            {{ zone.zone_name or 'Zona sin nombre' }}
                          </td>
                          <td align="right" style="vertical-align: middle;">
                            {% if zone.max_q is not none and zone.max_q > 0 %}
                            <span style="display: inline-block; padding: 3px 8px; border-radius: 5px; font-size: 11px; font-weight: bold; background-color: #fef2f2; color: #991b1b; border: 1px solid #fecaca; margin-right: 5px; vertical-align: middle;">
                              Q: {{ "%.1f"|format(zone.max_q) }} l/s/m
                            </span>
                            {% endif %}
                            <span style="display: inline-block; padding: 3px 11px; border-radius: 999px; font-size: 11.5px; font-weight: bold; background-color: {{ zone.alert_color or '#94a3b8' }}; color: {{ badge_text }}; white-space: nowrap;">
                              {{ zone.alert_label or 'Sin alerta' }}
                            </span>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                  {% set map_cid = zone_map_cids.get(zone.zone_id) %}
                  {% if map_cid %}
                  <tr>
                    <td style="padding: 0 16px 12px 16px;">
                      <img src="cid:{{ map_cid }}" width="576" style="display: block; width: 100%; max-width: 576px; height: auto; border-radius: 5px; border: 1px solid #e2e8f0;" alt="Ortofoto de {{ zone.zone_name or 'la zona' }}">
                    </td>
                  </tr>
                  {% endif %}
                  <tr>
                    <td style="padding: 0 16px 12px 16px;">
                      <p style="margin: 0 0 8px 0; color: #94a3b8; font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.3px;">
                        Evolución prevista (modelo {{ (zone.model or "-")|upper }})
                      </p>
                      {% set alert_intervals = zone.intervals | selectattr('alert_level') | list %}
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                        {% for iv in alert_intervals %}
                        {% set iv_badge_text = '#ffffff' if iv.alert_level in ['red', 'orange'] else '#0f172a' %}
                        <tr>
                          <td width="4" style="background-color: {{ iv.alert_color or '#94a3b8' }}; font-size: 1px; line-height: 1px;">&nbsp;</td>
                          <td style="padding: 7px 0 7px 10px; {% if not loop.last %}border-bottom: 1px solid #eef2f6;{% endif %}">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                              <tr>
                                <td>
                                  <span style="display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 10.5px; font-weight: bold; background-color: {{ iv.alert_color or '#94a3b8' }}; color: {{ iv_badge_text }}; white-space: nowrap;">
                                    {{ iv.alert_label or 'Sin alerta' }}
                                  </span>
                                  <span style="color: #334155; font-size: 12px; margin-left: 8px;">
                                    {{ iv.start_time | madrid_time if iv.start_time else '-' }} &rarr; {{ iv.end_time | madrid_time if iv.end_time else '-' }}
                                  </span>
                                </td>
                                <td align="right" style="color: #1e293b; font-size: 12px; font-weight: bold; white-space: nowrap; padding-right: 4px;">
                                  {{ "%.2f"|format(iv.max_hs) ~ " m" if iv.max_hs is not none else "-" }}
                                </td>
                              </tr>
                            </table>
                          </td>
                        </tr>
                        {% else %}
                        <tr>
                          <td style="padding: 8px 0; color: #94a3b8; font-size: 12px;">
                            {% if zone.intervals %}
                              Sin alertas previstas para esta zona: el oleaje se mantiene en niveles normales durante todo el horizonte.
                            {% else %}
                              Sin datos del modelo {{ zone.model or 'de referencia' }} disponibles para esta zona.
                            {% endif %}
                          </td>
                        </tr>
                        {% endfor %}
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            {% endfor %}
          {% else %}
            <tr>
              <td style="padding: 0 32px 16px 32px;">
                <p style="color: #64748b; font-size: 13.5px; margin: 0;">
                  Este sistema de previsión no tiene zonas configuradas para el análisis de alertas.
                </p>
              </td>
            </tr>
          {% endif %}

          <!-- Pie de página -->
          <tr>
            <td style="padding: 20px 32px 28px 32px; border-top: 1px solid #e2e8f0;">
              <p style="color: #94a3b8; font-size: 11.5px; margin: 0 0 4px 0;">
                Identificador del sistema de previsión: #{{ forecast_system_id }}
              </p>
              <p style="color: #94a3b8; font-size: 11.5px; margin: 0;">
                Este es un aviso automático de <strong style="color: #64748b;">AquaticaSpo</strong>, no respondas a este correo.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
