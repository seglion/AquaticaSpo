# Plantilla del .env de PRODUCCIÓN de AquaticaSpo (spo.aquatica.gal).
#
# Copiar a `.env` EN EL SERVIDOR y rellenar con secretos propios de producción
# (NO reutilizar los de desarrollo). Este .env NO se commitea (está en .gitignore);
# esta plantilla sí, para documentar las claves necesarias.
#
#   cp .env.prod.example .env   &&   nano .env

# --- Base de datos (PostGIS, contenedor interno 'db') ---
POSTGRES_USER=forecast_user
POSTGRES_PASSWORD=            # <-- secreto de producción
POSTGRES_SERVER=db            # nombre del servicio en la red interna (no cambiar)
POSTGRES_PORT=5432
POSTGRES_DB=forecast_db

# --- Auth backend ---
JWT_SECRET_KEY=               # <-- secreto largo aleatorio de producción

# --- CORS: orígenes del frontend permitidos (separados por comas) ---
ALLOWED_ORIGINS=https://spo.aquatica.gal

# --- RabbitMQ (contenedor interno 'rabbitmq') ---
RABBITMQ_USER=
RABBITMQ_PASS=                # <-- secreto de producción
# RABBITMQ_HOST lo fija docker-compose.prod.yml a 'rabbitmq' (no hace falta aquí)

# --- Cuenta de servicio que usan cron/worker/mailer contra la API ---
# Debe existir como usuario admin en la BD (ver initdb/init.sql).
API_USER=
API_PASSWORD=                 # <-- secreto de producción

# --- Mailer (cuenta de servicio dedicada + Brevo/SMTP) ---
MAILER_API_USER=mailer_service
MAILER_API_PASSWORD=          # <-- secreto de producción
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
MAILER_EXCLUDE_EMAILS=        # emails a excluir de notificaciones (coma-separados; opcional)

# --- Routing de mensajería ---
BINDING_KEY=forecast.#

# BACKEND_API_URL lo fija docker-compose.prod.yml a http://api:8000 (no tocar).
